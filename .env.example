# Novaura Core Environment Variables
# Do NOT commit your actual .env file.
# Copy this file to .env and fill in your actual keys.

# Google Gemini API Key (for Chat, Analysis, Grounding)
GEMINI_API_KEY=

# Stripe Secret Key (for Stripe Demo)
STRIPE_SECRET_KEY=

# Google OAuth Client ID (for GCP Auth)
GOOGLE_CLIENT_ID=

# Firebase Configuration (for Auth/Database)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Add any other third-party API keys below (e.g., OpenAI, Anthropic, ElevenLabs)
