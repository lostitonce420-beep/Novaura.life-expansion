# ==========================================
# Novaura Application - Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual keys.
# WARNING: Never commit your actual .env file to version control!

# ------------------------------------------
# 1. Gemini API Configuration (Required)
# ------------------------------------------
# Used for all AI features: Chat, Image Generation, Voice Live, Analysis, etc.
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# 2. Google Cloud Admin Credentials (Optional/Backend)
# ------------------------------------------
# Required if you are moving the "Cloud Manager" features to a Node.js backend
# to programmatically provision Cloud Run, Firebase, or generate API keys.
# Get this from: Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys
# Save the path to the downloaded JSON file here:
GOOGLE_APPLICATION_CREDENTIALS=./path/to/your/service-account-key.json

# Alternatively, if passing the raw JSON string in environments like Vercel/Render:
# GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON={ "type": "service_account", "project_id": "..." }

# ------------------------------------------
# 3. Firebase Admin SDK (Optional/Backend)
# ------------------------------------------
# Required if you implement backend authentication verification or database management.
# Get this from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-project.iam.gserviceaccount.com
# Note: Private keys need to have literal \n replaced with actual line breaks in some environments
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# ------------------------------------------
# 4. Frontend Public Variables (Vite)
# ------------------------------------------
# If you need variables accessible in the React frontend, prefix them with VITE_
# Example: VITE_FIREBASE_API_KEY=your_public_firebase_api_key
